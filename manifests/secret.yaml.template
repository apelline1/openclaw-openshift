# ──────────────────────────────────────────────────────────────────────────────
# SECRET TEMPLATE — fill in values, rename to secret.yaml, then:
#   oc apply -f manifests/secret.yaml
#
# DO NOT commit secret.yaml. It is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: openclaw-secrets
  namespace: openclaw
  labels:
    app.kubernetes.io/name: openclaw
type: Opaque
stringData:
  # A random token to secure the Gateway API — generate with:
  #   openssl rand -hex 32
  gateway-token: "REPLACE_WITH_RANDOM_TOKEN"

  # Your OpenAI API key — get one at https://platform.openai.com/api-keys
  openai-api-key: "sk-..."
